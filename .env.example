# Local pilot: copy this file to .env. Keep .env private.
LEAD_DEBUG=false
# Empty = self-contained SQLite pilot. PostgreSQL is supported via the URL below.
DATABASE_URL=
# DATABASE_URL=postgresql://radar:CHANGE_ME@127.0.0.1:5432/logistics_radar
# Keep data paths local to one computer; do not synchronize live databases.
LEAD_DATA_DIR=./data
LEAD_AUTOMATIC_ENABLED=false
LEAD_MAX_ITEMS=8
LEAD_MAX_PAGES=1
# Revisit the first 3 listing pages each cycle; this is not a full historical crawl.
LEAD_HEAD_PAGES=3
LEAD_CRAWL_TIMEOUT=180

# Models are OFF by default. No provider/key is bundled or automatically used.
# v0.2: configure address, model, enable switch and quotas in the AI settings page.
# Environment values initialize new configurations only; saved UI settings take precedence.
# Keys entered in the UI use the operating system credential store, never the database.
LEAD_MODEL_ENABLED=false
LEAD_MODEL_BASE_URL=
LEAD_MODEL_NAME=
LEAD_MODEL_API_KEY=
LEAD_MODEL_DAILY_BUDGET=30
# Optional Brave Search key; search has its own UI switch and daily request limit.
LEAD_SEARCH_API_KEY=

